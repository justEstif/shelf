package components

templ loginPage(csrfToken string, errorMsg string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Login — Shelf</title>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
		<link rel="stylesheet" href="/static/css/tailwind.css"/>
		<script>
			(function(){var t=localStorage.getItem('shelf-theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.classList.add('dark')}})();
		</script>
	</head>
	<body class="min-h-screen bg-surface-soft text-body font-sans antialiased flex items-center justify-center">
		<div class="w-full max-w-sm bg-canvas border border-hairline rounded-lg p-8">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-medium text-ink">📚 Shelf</h1>
				<button onclick="document.documentElement.classList.toggle('dark');localStorage.setItem('shelf-theme',document.documentElement.classList.contains('dark')?'dark':'light')" class="w-8 h-8 flex items-center justify-center rounded-md text-muted hover:text-ink" title="Toggle theme">
					<span class="inline dark:hidden">🌙</span>
					<span class="hidden dark:inline">☀️</span>
				</button>
			</div>
			if errorMsg != "" {
				<div class="text-sm text-coral bg-coral/10 rounded-md px-4 py-3 mb-4">
					{ errorMsg }
				</div>
			}
			<form method="post" action="/admin/login">
				<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
				<div class="mb-4">
					<label class="block text-sm text-muted mb-2">Password</label>
					<input type="password" name="password" class="w-full h-11 px-4 text-sm bg-canvas border border-hairline rounded-sm focus:border-info-border focus:outline-none" autocomplete="current-password" autofocus/>
				</div>
				<button type="submit" class="w-full bg-primary text-on-dark font-medium rounded-lg px-6 py-3 text-sm active:bg-primary-active">Login</button>
			</form>
		</div>
	</body>
	</html>
}
