package components

import (
	"fmt"

	"github.com/justestif/shelf/internal/storage"
)

func usagePercent(used, max int64) string {
	if max <= 0 {
		return "0.0"
	}
	pct := float64(used) / float64(max) * 100
	if pct > 100 {
		pct = 100
	}
	return fmt.Sprintf("%.1f", pct)
}

templ adminPage(entries []storage.Entry, token string, csrfToken string, uploadMsg string, visibility map[string]string, diskUsage int64, maxVolume int64) {
	@Layout("Admin") {
		<div class="max-w-4xl mx-auto">
			<h1 class="text-3xl font-medium text-ink mb-8">Admin</h1>

			<!-- Upload section -->
			<section class="mb-8">
				<h2 class="text-lg font-medium text-ink mb-3">Upload</h2>
				<div class="bg-canvas border border-hairline rounded-lg p-6">
					if uploadMsg != "" {
						<div class="text-sm text-warning bg-warning/10 rounded-md px-4 py-3 mb-4">
							{ uploadMsg }
						</div>
					}
					<form hx-post="/admin/upload" hx-target="#file-list" hx-swap="outerHTML" hx-encoding="multipart/form-data" class="space-y-4">
						<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
						<input type="text" name="folder" placeholder="Folder name (optional, for multi-file uploads)" class="w-full h-11 px-4 text-sm bg-canvas border border-hairline rounded-sm focus:border-info-border focus:outline-none"/>
						<input type="file" name="files" multiple class="block w-full text-sm text-muted file:mr-4 file:py-2 file:px-4 file:rounded-sm file:border-0 file:text-sm file:font-medium file:bg-surface-soft file:text-ink cursor-pointer"/>
						<button type="submit" class="bg-primary text-on-dark font-medium rounded-lg px-6 py-3 text-sm active:bg-primary-active">Upload</button>
					</form>

					<!-- Drag & drop zone -->
					<div id="drop-zone" class="border-2 border-dashed border-hairline rounded-lg p-8 text-center text-muted mt-4 cursor-pointer"
						onclick="document.querySelector('input[name=files]').click()">
						Drop files here or click to browse
					</div>
				</div>
			</section>

			<!-- Files section -->
			<section class="mb-8">
				<div class="flex items-center justify-between mb-3">
					<h2 class="text-lg font-medium text-ink">Files</h2>
					<span class="text-xs text-muted">{ storage.FormatFileSize(diskUsage) } / { storage.FormatFileSize(maxVolume) }</span>
				</div>
				<div class="w-full bg-surface-soft rounded-full h-1.5 mb-4">
					<div class="bg-primary rounded-full h-1.5 transition-all" style="width: { usagePercent(diskUsage, maxVolume) }%"></div>
				</div>
				@fileListPartial(entries, csrfToken, "", visibility)
			</section>

			<!-- Token section -->
			<section class="mb-8">
				<h2 class="text-lg font-medium text-ink mb-3">API Token</h2>
				<div class="bg-canvas border border-hairline rounded-lg p-6">
					<p class="text-sm text-muted mb-4">Use this token to authenticate API requests. Pass it as <code class="bg-surface-soft px-1.5 py-0.5 rounded-sm text-xs font-mono">Authorization: Bearer &lt;token&gt;</code></p>
					@tokenPartial(token)
					<form hx-post="/admin/token" hx-target="#token-display" hx-swap="outerHTML" class="mt-4">
						<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
						<button type="submit" class="bg-canvas border border-hairline text-ink font-medium rounded-lg px-4 py-2 text-sm active:bg-surface-soft">Generate New Token</button>
					</form>
				</div>
			</section>

			<!-- Logout -->
			<div class="mt-8">
				<form method="post" action="/admin/logout">
					<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
					<button type="submit" class="text-sm text-muted">Logout</button>
				</form>
			</div>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<script>
			document.addEventListener("htmx:confirm", function(e) {
				if (!e.detail.question) return;
				e.preventDefault();
				Swal.fire({
					title: "Confirm",
					text: e.detail.question,
					showCancelButton: true,
					confirmButtonText: "Confirm",
					cancelButtonText: "Cancel",
				}).then(function(result) {
					if (result.isConfirmed) e.detail.issueRequest(true);
				});
			});
		</script>
		<!-- Drag & drop JS -->
		<script>
			const dropZone = document.getElementById('drop-zone');
			if (dropZone) {
				['dragenter', 'dragover'].forEach(evt => {
					dropZone.addEventListener(evt, e => {
						e.preventDefault();
						dropZone.classList.add('border-info-border', 'text-info', 'bg-info/5');
					});
				});
				['dragleave', 'drop'].forEach(evt => {
					dropZone.addEventListener(evt, e => {
						e.preventDefault();
						dropZone.classList.remove('border-info-border', 'text-info', 'bg-info/5');
					});
				});
				dropZone.addEventListener('drop', e => {
					const input = document.querySelector('input[name="files"]');
					input.files = e.dataTransfer.files;
					// Auto-submit via HTMX
					htmx.trigger(input.closest('form'), 'submit');
				});
			}
		</script>
	}
}

templ fileListPartial(entries []storage.Entry, csrfToken string, errMsg string, visibility map[string]string) {
	<div id="file-list">
		if errMsg != "" {
			<div class="text-sm text-warning bg-warning/10 rounded-md px-4 py-3 mb-4">
				{ errMsg }
			</div>
		}
		if len(entries) == 0 {
			<p class="text-sm text-muted py-4">No files uploaded yet.</p>
		} else {
			<div class="bg-canvas border border-hairline rounded-lg divide-y divide-hairline">
				for _, entry := range entries {
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-4 py-3">
						<div class="flex items-center gap-3 min-w-0">
							if entry.IsDir {
								<span class="text-muted shrink-0">📁</span>
							} else {
								<span class="text-muted shrink-0">📄</span>
							}
							<div class="min-w-0">
								<span class="font-mono text-sm text-ink truncate block">{ entry.Path }</span>
								<span class="text-xs text-muted">{ storage.FormatFileSize(entry.Size) }</span>
							</div>
						</div>
						<div class="flex gap-3 items-center flex-wrap">
							@visibilityBadge(entry.Path, visibility[entry.Path], csrfToken)
							<a href={ templ.SafeURL("/" + entry.Path) } class="text-xs text-link" target="_blank">View</a>
							<button class="text-xs text-error"
								hx-delete={ "/admin/delete/" + entry.Path }
								hx-target="#file-list"
								hx-swap="outerHTML"
								hx-confirm={ "Delete " + entry.Path + "?" }
								hx-headers={ `{ "X-CSRF-Token": "` + csrfToken + `" }` }>
							Delete
							</button>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

templ tokenPartial(token string) {
	<div id="token-display">
		if token != "" {
			<div class="bg-surface-soft rounded-md p-3 font-mono text-sm break-all select-all">
				{ token }
			</div>
		} else {
			<p class="text-sm text-muted">No token generated yet. Click generate to create one.</p>
		}
	</div>
}

templ visibilityBadge(path string, visibility string, csrfToken string) {
	<div class="flex items-center gap-2" hx-target="this" hx-swap="outerHTML">
		if visibility == "public" {
			<span class="text-xs px-2 py-0.5 rounded-sm bg-surface-soft text-muted">Public</span>
		} else if visibility == "private" {
			<span class="text-xs px-2 py-0.5 rounded-sm bg-ink text-on-dark">Private</span>
		} else if visibility == "protected" {
			<span class="text-xs px-2 py-0.5 rounded-sm bg-coral text-on-dark">Protected</span>
		}
		<form hx-post="/admin/visibility" hx-target="this" hx-swap="outerHTML" class="inline-flex">
			<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
			<input type="hidden" name="path" value={ path }/>
			<select name="visibility"
				onchange="var sel=this; Swal.fire({title:'Change visibility',text:'Set to '+this.value+'?',showCancelButton:true,confirmButtonText:'Confirm',cancelButtonText:'Cancel'}).then(function(r){ if(r.isConfirmed) htmx.trigger(sel.closest('form'),'submit'); else sel.value=sel.dataset.current; });"
				data-current={ visibility }
				class="text-xs bg-canvas border border-hairline rounded-sm px-1.5 py-0.5 text-body focus:outline-none focus:border-info-border">
				<option value="public" selected={ visibility == "public" }>Public</option>
				<option value="private" selected={ visibility == "private" }>Private</option>
				<option value="protected" selected={ visibility == "protected" }>Protected</option>
			</select>
		</form>
	</div>
}
