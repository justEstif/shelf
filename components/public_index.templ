package components

import "github.com/justestif/shelf/internal/storage"

templ publicIndex(entries []storage.Entry, prefix string) {
	@Layout("Shelf") {
		<div class="max-w-3xl mx-auto">
			<h1 class="text-3xl font-bold mb-6">
				if prefix != "" {
					📁 { prefix }
				} else {
					📚 Shelf
				}
			</h1>
			if prefix != "" {
				<a href="/" class="btn btn-ghost btn-sm mb-4">← Back to index</a>
			}
			if len(entries) == 0 {
				<div class="text-center py-12 text-base-content/50">
					<p class="text-lg">Empty shelf</p>
					<p class="text-sm mt-1">No files or folders here yet.</p>
				</div>
			}
			<div class="grid gap-2">
				for _, entry := range entries {
					if entry.IsDir {
						<a href={ templ.SafeURL("/" + prefix + entry.Name + "/") } class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
							<div class="card-body flex-row items-center gap-3 p-4">
								<span class="text-2xl">📁</span>
								<div class="flex-1">
									<span class="font-medium">{ entry.Name }</span>
								</div>
								<span class="text-sm text-base-content/50">folder</span>
							</div>
						</a>
					} else {
						<a href={ templ.SafeURL("/" + prefix + entry.Name) } class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow">
							<div class="card-body flex-row items-center gap-3 p-4">
								<span class="text-2xl">📄</span>
								<div class="flex-1">
									<span class="font-medium">{ entry.Name }</span>
								</div>
								<span class="text-sm text-base-content/50">{ storage.FormatFileSize(entry.Size) }</span>
							</div>
						</a>
					}
				}
			</div>
		</div>
	}
}
