package components

import "github.com/justestif/shelf/internal/storage"

templ publicIndex(entries []storage.Entry, prefix string) {
	@Layout("Shelf") {
		<div class="max-w-3xl mx-auto">
			<h1 class="text-3xl font-medium text-ink mb-6">
				if prefix != "" {
					{ prefix }
				} else {
					Shelf
				}
			</h1>
			if prefix != "" {
				<a href="/" class="text-sm text-link mb-4 inline-block">← Back to index</a>
			}
			if len(entries) == 0 {
				<div class="text-center py-16 text-muted">
					<p>Empty shelf</p>
					<p class="text-sm mt-1">No files or folders here yet.</p>
				</div>
			}
			if len(entries) > 0 {
				<div class="border border-hairline rounded-lg bg-canvas divide-y divide-hairline">
					for _, entry := range entries {
						if entry.IsDir {
							<a href={ templ.SafeURL("/" + prefix + entry.Name + "/") } class="flex items-center justify-between px-4 py-3 gap-3">
								<div class="flex items-center gap-3 min-w-0">
									<span class="text-muted shrink-0">📁</span>
									<span class="text-sm text-ink truncate">{ entry.Name }</span>
								</div>
								<span class="text-xs text-muted shrink-0">{ storage.FormatFileSize(entry.Size) }</span>
							</a>
						} else {
							<a href={ templ.SafeURL("/" + prefix + entry.Name) } class="flex items-center justify-between px-4 py-3 gap-3">
								<div class="flex items-center gap-3 min-w-0">
									<span class="text-muted shrink-0">📄</span>
									<span class="text-sm text-ink truncate">{ entry.Name }</span>
								</div>
								<span class="text-xs text-muted shrink-0">{ storage.FormatFileSize(entry.Size) }</span>
							</a>
						}
					}
				</div>
			}
		</div>
	}
}
